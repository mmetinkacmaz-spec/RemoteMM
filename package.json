{
  "name": "remotemm",
  "private": true,
  "version": "12.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "agent": "node agent/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "app:build": "vite build && electron-builder",
    "app:dist": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.remotemm.app",
    "productName": "RemoteMM Enterprise",
    "copyright": "Copyright © 2026 RemoteMM Technology",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RemoteMM Enterprise Control",
      "artifactName": "RemoteMM_Setup.exe"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "canvas": "^3.2.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
